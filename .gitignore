# Node
node_modules/
npm-debug.log*
package-lock.json

# Local state / scratch
**/announcer.json
discord/announcer.json
web/_shots.mjs
*.tmp

# OS
.DS_Store

# Map packs (large; provided by the user at runtime)
server/maps/*.pk3
# fetch-maps.sh working files (lock, failure list, in-flight temps)
server/maps/.fetch-*
server/maps/.part-*

# Server-written race records / finish-event log (runtime data; the collector
# ships them into the stats DB)
server/topscores/**
server/racelog/**
!server/topscores/.gitkeep
!server/racelog/.gitkeep

# SQLite runtime journals
data/*.sqlite-wal
data/*.sqlite-shm
*.sqlite-wal
*.sqlite-shm
.env
# Per-box TV capture secrets/config (see server/tv/tv.env.example)
server/tv/tv.env
backups/

# SFTP demo dropbox: uploaded demos (runtime, per-box) + private host keys.
# The committed public keys (server/sftp/keys/*.pub) + users.conf stay tracked.
server/sftp-uploads/
server/sftp/hostkeys/
# Client-demo ingestion watcher runtime (scripts/ingest-demos.sh)
demo-ingest.log
.demo-ingest.lock

# xpiry.dev monitoring: generated per-box heartbeat ping URLs (semi-secret —
# anyone with the URL can post a heartbeat) + heartbeat runtime lock/log.
scripts/xpiry-monitors.local.env
.xpiry-heartbeat.lock
xpiry-heartbeat.log

# Generated WR-ghost viewer meshes (converted on the box, mounted into web)
web/public/maps/*.glb

# Local scratch (screenshots, large paks deployed out-of-band)
temp/

.env.production
