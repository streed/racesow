# /etc/nfs.conf.d/racesow.conf on the EU box.
# NFSv4.2 only (one TCP port, 2049, no rpcbind/mountd side ports to open), and
# nfsd listens on the WireGuard address only, so it is unreachable from the
# internet even before the firewall.
#   apt install nfs-kernel-server && systemctl restart nfs-server
# docs/map-store-runbook.md, step C.
[nfsd]
vers3 = n
vers4.0 = n
vers4.1 = y
vers4.2 = y
host = 10.66.0.1
