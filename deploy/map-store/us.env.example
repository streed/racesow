# Lines to add to ~/racesow/.env on the US box (the .env that
# docker-compose.agent.yml and docker-compose.warfork.yml read; NOT
# server/.env). docs/map-store-runbook.md, step E.
#
# Warsow reads the store over NFS and falls back to the snapshot.
MAP_STORE_DIR=/srv/racesow/maps
MAP_STORE_SNAPSHOT_DIR=./server/maps-snapshot
# How often the engine rescans the store for new packs (seconds).
MAPSCAN_SECONDS=60
# Warfork has no mapscan patch and no store fallback: it reads the snapshot,
# which is always on local disk and at most about an hour behind.
WARFORK_MAPS_DIR=./server/maps-snapshot
