# Lines to add to ~/racesow/.env on the US box (the .env that
# docker-compose.agent.yml and docker-compose.warfork.yml read; NOT
# server/.env). docs/map-store-runbook.md, step E.
#
# Both game servers read the store over NFS and fall back to the local
# snapshot when the mount does not answer at launch. MAP_STORE_DIR and
# WARFORK_MAPS_DIR are therefore the SAME mountpoint, and neither may be set
# to the snapshot: scripts/map-snapshot.sh syncs the store INTO the snapshot,
# so pointing a store key at the snapshot leaves it with nothing to copy from
# and the box silently stops receiving maps. The script refuses that
# configuration outright.
MAP_STORE_DIR=/srv/racesow/maps
WARFORK_MAPS_DIR=/srv/racesow/maps
MAP_STORE_SNAPSHOT_DIR=./server/maps-snapshot
# How often each engine rescans the store for new packs (seconds). Both games
# read this one key, so they stay on the same schedule.
MAPSCAN_SECONDS=60
