# Per-box config for the TV capture service (server/docker-compose.tv.yml).
# Copy to server/tv/tv.env (gitignored) and fill in the values for THIS box.
# Only the per-box + secret vars live here; invariants are in the compose file.

# HLS output subdir under /hls, and the site path /hls/<id>/.
#   EU box: eu     US box: us
STREAM_ID=eu

# Enrolled stats server id (EU Central = 1, US East = 2). Tells the heartbeat
# which stream it belongs to.
SERVER_ID=1

# Name shown on the idle "waiting for racers" card.
SERVER_NAME=Racesow - EU Central

# Where the encoder POSTs its live/idle + POV heartbeat. The path's id MUST equal
# SERVER_ID above (the endpoint rejects a mismatch).
HEARTBEAT_URL=https://racesow.org/api/streams/1/health

# Bearer for the heartbeat == this box's game-server per-server INGEST_TOKEN.
# /api/streams/:id/health authenticates it exactly like /api/ingest and requires
# the token's serverId to equal SERVER_ID, so the legacy shared token is refused.
#   EU box: the INGEST_TOKEN in server/.env
#   US box: the INGEST_TOKEN the warsow-race container runs with
#           (docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' warsow-race | grep INGEST_TOKEN)
HEARTBEAT_TOKEN=replace-with-this-box-INGEST_TOKEN

# Optional encoder overrides (defaults: 1280x720 / 30fps / 2500k). Lower these
# on a CPU-constrained box.
# WIDTH=1280
# HEIGHT=720
# FPS=30
# VBITRATE=2500k
