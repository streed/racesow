# Restart this box's Racesow game servers. Run daily at 05:00 local by
# racesow-restart.timer. `docker restart` re-executes the container's
# entrypoint.sh, so on the way back up each server rebuilds g_maplist — picking
# up any maps a moderator has newly blocked (GET /api/game/blocked-maps) and
# dropping them from the vote pool + cycle — and recompiles the gametype.
# The container names are identical on the full and agent tiers, so this one
# unit serves both.
#
# BOTH games are restarted. warfork-race was missing here until 2026-08-09,
# which meant the Warfork nodes never took a nightly bounce: they picked up
# newly blocked maps only when someone redeployed them, and they missed the
# incidental recovery the restart gives a server that has gone bad. A box
# without a Warfork container just makes that line a no-op, which is why each
# container is restarted by its own ExecStart with a `-` prefix (a missing
# container must not fail the unit and skip the one that IS there).
#
# Template: __RACESOW_USER__ is substituted by systemd/install.sh (the user must
# be able to talk to Docker, same as the other racesow units).
[Unit]
Description=Restart the Racesow game server (daily 5am local)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=__RACESOW_USER__
ExecStart=-/usr/bin/docker restart warsow-race
ExecStart=-/usr/bin/docker restart warfork-race
